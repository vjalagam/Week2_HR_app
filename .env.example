# Never commit real values. In production, prefer the corresponding *_FILE variable.
NEBIUS_API_KEY=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=abc-enterprise-rag
AUTH_REQUIRED=true
# Generate hashes with: python -c "from enterprise_rag.security import hash_password; print(hash_password('change-me'))"
AUTH_USERS_JSON={"admin":{"password_hash":"pbkdf2_sha256$replace$salted_hash","role":"admin"}}
RAG_DATABASE_PATH=data/rag.db
RATE_LIMIT_PER_MINUTE=30
MAX_QUESTION_LENGTH=2000
LOG_LEVEL=INFO
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct
